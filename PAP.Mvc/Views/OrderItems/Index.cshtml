@model IEnumerable<PAP.DataAccess.OrderItem>
@using PAP.Business
@{
    ViewBag.Title = "Artículos de pedidos";
}

<div id="crud-root" data-details-url="@Url.Action("Details")" data-singular="artículo del pedido">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2 class="mb-0">Artículos de pedidos</h2>
        <button type="button" class="btn btn-primary" data-crud="create">Agregar</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="white-space: pre-line;">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Libro</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Descuento</th>
                    <th class="text-center">Detalle</th>
                    <th class="text-center">Editar</th>
                    <th class="text-center">Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@("Pedido #" + item.OrderId)</td>
                        <td>@(item.Book?.Title)</td>
                        <td>@item.Quantity</td>
                        <td>@(item.UnitPrice.ToString("N2"))</td>
                        <td>@(item.Discount.ToString("N2"))</td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-secondary" data-crud="details" data-id="@item.Id">Detalle</button></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-primary" data-crud="edit" data-id="@item.Id">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-crud="delete" data-id="@item.Id" data-name="@(item.Book?.Title)">Eliminar</button></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No hay registros.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form id="entityForm" method="post" data-create-action="@Url.Action("Create")" data-edit-action="@Url.Action("Edit")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="formModalTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
<div class="col-md-6 mb-3">
<label class="form-label" for="f_OrderId">Pedido</label>
<select class="form-select" id="f_OrderId" name="OrderId" required>
<option value="">-- Seleccione --</option>
@foreach (var o in (IEnumerable<LookupItem>)ViewBag.Orders)
{
<option value="@o.Id">@o.Text</option>
}
</select>
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_BookId">Libro</label>
<select class="form-select" id="f_BookId" name="BookId" required>
<option value="">-- Seleccione --</option>
@foreach (var o in (IEnumerable<LookupItem>)ViewBag.Books)
{
<option value="@o.Id">@o.Text</option>
}
</select>
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_Quantity">Cantidad</label>
<input class="form-control" type="number" step="1" id="f_Quantity" name="Quantity" min="1" max="100000" required value="1" />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_UnitPrice">Precio unitario</label>
<input class="form-control" type="number" step="any" id="f_UnitPrice" name="UnitPrice" min="0" max="9999999999999" required value="0" />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_Discount">Descuento</label>
<input class="form-control" type="number" step="any" id="f_Discount" name="Discount" min="0" max="9999999999999" required value="0" />
</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle de artículo del pedido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
<dt class="col-sm-4">Pedido</dt><dd class="col-sm-8" data-field="OrderNumber"></dd>
<dt class="col-sm-4">Libro</dt><dd class="col-sm-8" data-field="BookTitle"></dd>
<dt class="col-sm-4">Cantidad</dt><dd class="col-sm-8" data-field="Quantity"></dd>
<dt class="col-sm-4">Precio unitario</dt><dd class="col-sm-8" data-field="UnitPriceText"></dd>
<dt class="col-sm-4">Descuento</dt><dd class="col-sm-8" data-field="DiscountText"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="@Url.Action("Delete")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title">Eliminar artículo del pedido</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Seguro que desea eliminar <strong id="deleteName"></strong>? Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/crud.js"></script>
}

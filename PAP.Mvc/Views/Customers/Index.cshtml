@model IEnumerable<PAP.DataAccess.Customer>
@using PAP.Business
@{
    ViewBag.Title = "Clientes";
}

<div id="crud-root" data-details-url="@Url.Action("Details")" data-singular="cliente">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2 class="mb-0">Clientes</h2>
        <button type="button" class="btn btn-primary" data-crud="create">Agregar</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="white-space: pre-line;">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo electrónico</th>
                    <th>Teléfono</th>
                    <th>Activo</th>
                    <th class="text-center">Detalle</th>
                    <th class="text-center">Editar</th>
                    <th class="text-center">Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.FirstName + " " + item.LastName)</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@(item.IsActive ? "Sí" : "No")</td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-secondary" data-crud="details" data-id="@item.Id">Detalle</button></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-primary" data-crud="edit" data-id="@item.Id">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-crud="delete" data-id="@item.Id" data-name="@(item.FirstName + " " + item.LastName)">Eliminar</button></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No hay registros.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form id="entityForm" method="post" data-create-action="@Url.Action("Create")" data-edit-action="@Url.Action("Edit")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="formModalTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
<div class="col-md-6 mb-3">
<label class="form-label" for="f_FirstName">Nombre</label>
<input class="form-control" type="text" id="f_FirstName" name="FirstName" maxlength="100" required />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_LastName">Apellido</label>
<input class="form-control" type="text" id="f_LastName" name="LastName" maxlength="100" required />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_Email">Correo electrónico</label>
<input class="form-control" type="email" id="f_Email" name="Email" maxlength="150" required />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_Phone">Teléfono</label>
<input class="form-control" type="text" id="f_Phone" name="Phone" maxlength="30" />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_BirthDate">Fecha de nacimiento</label>
<input class="form-control" type="date" id="f_BirthDate" name="BirthDate" />
</div>
<div class="col-md-6 mb-3">
<div class="form-check mt-4">
<input class="form-check-input" type="checkbox" id="f_IsActive" name="IsActive" value="true" checked />
<input type="hidden" name="IsActive" value="false" />
<label class="form-check-label" for="f_IsActive">Activo</label>
</div>
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_password">Contraseña</label>
<input class="form-control" type="password" id="f_password" name="password" maxlength="100" autocomplete="new-password" />
<div class="form-text">Obligatoria al crear (mínimo 8 caracteres). Al editar, déjela en blanco para conservar la actual.</div>
</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle de cliente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
<dt class="col-sm-4">Nombre</dt><dd class="col-sm-8" data-field="FirstName"></dd>
<dt class="col-sm-4">Apellido</dt><dd class="col-sm-8" data-field="LastName"></dd>
<dt class="col-sm-4">Correo electrónico</dt><dd class="col-sm-8" data-field="Email"></dd>
<dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8" data-field="Phone"></dd>
<dt class="col-sm-4">Fecha de nacimiento</dt><dd class="col-sm-8" data-field="BirthDate"></dd>
<dt class="col-sm-4">Activo</dt><dd class="col-sm-8" data-field="IsActive"></dd>
<dt class="col-sm-4">Creado</dt><dd class="col-sm-8" data-field="CreatedAt"></dd>
<dt class="col-sm-4">Actualizado</dt><dd class="col-sm-8" data-field="UpdatedAt"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="@Url.Action("Delete")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title">Eliminar cliente</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Seguro que desea eliminar <strong id="deleteName"></strong>? Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/crud.js"></script>
}

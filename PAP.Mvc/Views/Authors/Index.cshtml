@model IEnumerable<PAP.DataAccess.Author>
@using PAP.Business
@{
    ViewBag.Title = "Autores";
}

<div id="crud-root" data-details-url="@Url.Action("Details")" data-singular="autor">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2 class="mb-0">Autores</h2>
        <button type="button" class="btn btn-primary" data-crud="create">Agregar</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="white-space: pre-line;">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>País</th>
                    <th>Fecha de nacimiento</th>
                    <th class="text-center">Detalle</th>
                    <th class="text-center">Editar</th>
                    <th class="text-center">Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Country</td>
                        <td>@(item.BirthDate.HasValue ? item.BirthDate.Value.ToString("yyyy-MM-dd") : "")</td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-secondary" data-crud="details" data-id="@item.Id">Detalle</button></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-primary" data-crud="edit" data-id="@item.Id">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-crud="delete" data-id="@item.Id" data-name="@(item.FirstName + " " + item.LastName)">Eliminar</button></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No hay registros.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form id="entityForm" method="post" data-create-action="@Url.Action("Create")" data-edit-action="@Url.Action("Edit")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="formModalTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
<div class="col-md-6 mb-3">
<label class="form-label" for="f_FirstName">Nombre</label>
<input class="form-control" type="text" id="f_FirstName" name="FirstName" maxlength="100" required />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_LastName">Apellido</label>
<input class="form-control" type="text" id="f_LastName" name="LastName" maxlength="100" required />
</div>
<div class="col-12 mb-3">
<label class="form-label" for="f_Biography">Biografía</label>
<textarea class="form-control" id="f_Biography" name="Biography" rows="3"></textarea>
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_BirthDate">Fecha de nacimiento</label>
<input class="form-control" type="date" id="f_BirthDate" name="BirthDate" />
</div>
<div class="col-md-6 mb-3">
<label class="form-label" for="f_Country">País</label>
<input class="form-control" type="text" id="f_Country" name="Country" maxlength="100" />
</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle de autor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
<dt class="col-sm-4">Nombre</dt><dd class="col-sm-8" data-field="FirstName"></dd>
<dt class="col-sm-4">Apellido</dt><dd class="col-sm-8" data-field="LastName"></dd>
<dt class="col-sm-4">Biografía</dt><dd class="col-sm-8" data-field="Biography"></dd>
<dt class="col-sm-4">Fecha de nacimiento</dt><dd class="col-sm-8" data-field="BirthDate"></dd>
<dt class="col-sm-4">País</dt><dd class="col-sm-8" data-field="Country"></dd>
<dt class="col-sm-4">Creado</dt><dd class="col-sm-8" data-field="CreatedAt"></dd>
<dt class="col-sm-4">Libros</dt><dd class="col-sm-8" data-field="Books"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="@Url.Action("Delete")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title">Eliminar autor</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Seguro que desea eliminar <strong id="deleteName"></strong>? Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/crud.js"></script>
}
